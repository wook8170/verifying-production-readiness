#!/bin/bash
# vpr — 이 스킬의 단일 진입점.
#
# 존재 이유: 도구가 넷(new-report·ledger-lint·report-html·package)이면 사람은 넷을 외워야
# 하고, 실제로는 「형식이 뭐였지」에서 막힌다. 감정에서 「사용성」이 가장 낮았던 이유다.
# 하나만 기억하면 되게 한다: `vpr <동작>`. 각 하위 명령은 원래 스크립트를 그대로 부른다
# (기능을 두 벌로 만들지 않는다 — 갈리면 어느 쪽이 정본인지 아무도 모른다).
set -u
BIN=$(cd "$(dirname "$0")" && pwd)

usage() {
  cat <<'EOF'
vpr — 출하 검증(verifying-production-readiness) 단일 진입점

  vpr new <프로젝트 경로> [--full] [--axes 3,5,7]
                                    리포트 뼈대 생성 · 볼 축 선택(코어 ④⑥⑧⑨ 는 못 뺀다)
  vpr lint <리포트|디렉터리> [--strict]
                                    대장 기계 검증 R1–R13 — 판정 전 필수
  vpr render <리포트|디렉터리>       게시용 HTML (lint 통과 시에만)
  vpr package <출력 경로>            플러그인 배포 형태로 조립
  vpr test                          자체 테스트
  vpr rules                         규칙 요약 R1–R13

전형적인 흐름:
  vpr new ~/proj          →  게이트 목표를 착수 전에 수치로 채운다
                          →  감사하고 발견을 대장에 즉시 적는다
  vpr lint ~/proj         →  통과해야 판정이 유효하다
  vpr render ~/proj       →  Artifact 로 게시
EOF
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  new)      exec bash "$BIN/new-report.sh" "$@" ;;
  lint)     exec bash "$BIN/ledger-lint.sh" "$@" ;;
  render)   exec python3 "$BIN/report-html.py" "$@" ;;
  package)  exec bash "$BIN/package.sh" "$@" ;;
  test)     exec bash "$BIN/../test/run-tests.sh" "$@" ;;
  rules)    sed -n '/^## 규칙 요약/,/^## 알려진 한계/p' "$BIN/../README.md" | sed '$d' ;;
  ""|-h|--help|help) usage ;;
  *) echo "알 수 없는 동작: $cmd"; echo; usage; exit 2 ;;
esac
